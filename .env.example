# Copy to .env.local for local development (`npx supabase start` prints these values).
# On Vercel, the Supabase integration fills these in automatically.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable (new) or anon (legacy) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (new) or service_role (legacy) key — server only, never expose.
SUPABASE_SECRET_KEY=

# Public URL of the app, used in emails and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects the scheduled cleanup endpoint (Vercel Cron sends it automatically).
CRON_SECRET=

# --- Email notifications (optional) -------------------------------------------
# Any SMTP provider works (Resend, Brevo, Amazon SES, Mailgun, Postmark…).
# Leave SMTP_HOST empty to turn share/team emails off.
# Locally, Supabase's mail catcher listens on 127.0.0.1:54325 (see http://127.0.0.1:54324).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender shown in emails, e.g. "Nuvenca <no-reply@your-domain.com>" (a domain verified with your provider).
EMAIL_FROM=

# --- Google Drive import / "Save to Google Drive" (optional) --------------------
# From a Google Cloud project with the Google Drive API and Google Picker API enabled.
# These are public browser values (protect them with HTTP-referrer and OAuth origin
# restrictions in Google Cloud). Leave empty to hide the Google Drive features.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
# The Cloud project number ("App ID" for the Picker).
NEXT_PUBLIC_GOOGLE_APP_ID=
